clear all; close all; clc;

% Parámetros del circuito
R = 43e3;
C = 470e-9;
f = 50; % Frecuencia de la red
w = 2 * pi * f; % Frecuencia angular

% Transferencia de la red RC
num = 1;
den = [R*C 1];
H = tf(num, den);

% Simulación en el dominio del tiempo
t = 0:0.0001:160e-3; % Vector de tiempo
u = 220*sqrt(2)*sin(w*t); % Señal de entrada (tensión de red)

[y, tOut] = lsim(H, u, t); % Respuesta de la red RC (tensión en el capacitor)

% Definir el nivel de disparo del DIAC (cuando el capacitor llega a 30V)
V_trigger = 30;

% Encontrar el primer instante donde la señal del capacitor alcanza 30V
idx_trigger = find(y >= V_trigger, 1, 'first');
t_trigger = t(idx_trigger); % Tiempo de disparo

% Convertir el tiempo de disparo a ángulo en grados
theta_trigger = t_trigger * f * 360; 

% Graficar resultados
figure();
hold on;
plot(tOut, y, 'r', 'LineWidth', 1.5);
plot(t, u, 'b', 'LineWidth', 1.5);
plot(t_trigger, V_trigger, 'go', 'MarkerSize', 10, 'LineWidth', 2); % Punto de disparo
grid on;
legend('Tensión en el capacitor', 'Tensión de entrada', 'Punto de disparo');
title(sprintf('Ángulo de disparo: %.2f°', theta_trigger));
xlabel('Tiempo (s)');
ylabel('Voltaje (V)');

% Mostrar el resultado en la consola
fprintf('Ángulo de disparo del TRIAC: %.2f°\n', theta_trigger);
